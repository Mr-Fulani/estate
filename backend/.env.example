DATABASE_URL=postgresql+asyncpg://estate:estate_secret@localhost:5432/estate_db
SECRET_KEY=replace-with-a-long-random-value
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
CRM_WEBHOOK_SECRET=replace-with-a-separate-random-webhook-secret
AUTH_COOKIE_NAME=estate_admin_session
AUTH_CSRF_COOKIE_NAME=estate_admin_csrf
AUTH_SESSION_HOURS=12
AUTH_COOKIE_SECURE=false
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_LOGIN_MAX_ATTEMPTS=10
