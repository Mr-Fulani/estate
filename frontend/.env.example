NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
INTERNAL_API_URL=http://localhost:8000/api/v1
SITE_URL=http://localhost:3000

# Use the same values in frontend and backend environments.
SITE_LOCALES=ru,en,tr,ar
SITE_DEFAULT_LOCALE=ru
SITE_CURRENCIES=RUB,USD,EUR,TRY
SITE_DEFAULT_CURRENCY=RUB
CATALOG_CURRENCY=RUB

# Enable only on the reviewed public production site.
DEPLOYMENT_ENV=development
INDEXING_ENABLED=false
# Required if DEPLOYMENT_ENV=preview. Set unique values outside source control.
PREVIEW_USERNAME=
PREVIEW_PASSWORD=
