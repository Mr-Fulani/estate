#!/usr/bin/env bash
set -euo pipefail
umask 077
exec 9>/run/lock/estate-backup.lock
flock -n 9 || { echo 'Another estate backup is running' >&2; exit 1; }
dest=$(mktemp -d /var/backups/estate/"$(date -u +%Y%m%dT%H%M%SZ)"-XXXXXX)
dc=/usr/local/sbin/estate-compose
"$dc" exec -T db sh -c 'pg_dump -U "$POSTGRES_USER" -d "$POSTGRES_DB" -Fc' > "$dest/database.dump"
"$dc" exec -T db sh -c 'pg_dumpall -U "$POSTGRES_USER" --globals-only' > "$dest/globals.sql"
"$dc" exec -T db pg_restore --list < "$dest/database.dump" > "$dest/database.toc"
tar -C /var/lib/estate -czf "$dest/uploads.tar.gz" uploads
tar -C /etc -czf "$dest/config.tar.gz" estate
tar -tzf "$dest/uploads.tar.gz" >/dev/null
tar -tzf "$dest/config.tar.gz" >/dev/null
cp "$(readlink -f /opt/estate/current)/deploy/release.env" "$dest/release.env"
(cd "$dest" && sha256sum database.dump globals.sql uploads.tar.gz config.tar.gz release.env > SHA256SUMS && sha256sum -c SHA256SUMS)
touch "$dest/COMPLETE"
printf 'Backup: %s\n' "$dest"
du -sh "$dest"
