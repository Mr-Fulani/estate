# Database
DATABASE_URL=postgresql+asyncpg://estate:estate_secret@localhost:5432/estate_db
DB_USER=estate
DB_PASSWORD=estate_secret
DB_NAME=estate_db

# Backend
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
CRM_WEBHOOK_SECRET=replace-with-a-separate-random-webhook-secret
AUTH_COOKIE_NAME=estate_admin_session
AUTH_CSRF_COOKIE_NAME=estate_admin_csrf
AUTH_SESSION_HOURS=12
AUTH_COOKIE_SECURE=false
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_LOGIN_MAX_ATTEMPTS=10
TRUSTED_PROXY_NETWORKS=127.0.0.0/8,::1/128,172.16.0.0/12
ALLOWED_HOSTS=localhost,127.0.0.1,api
PUBLIC_FORM_RATE_LIMIT=5
PUBLIC_TRACK_RATE_LIMIT=30
PUBLIC_REVIEW_RATE_LIMIT=3
PUBLIC_RATE_WINDOW_MINUTES=15
PUBLIC_REVIEW_RATE_WINDOW_MINUTES=60

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Estate Agency
